# Copy to .env and fill in. The README explains where each value comes from.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL connection string, pasted exactly as the provider shows it
# (postgres:// or postgresql://). The app selects the asyncpg driver itself.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Only backs webhook de-duplication and the per-customer rate limit;
# with REDIS_ENABLED=false (or an empty URL) the bot runs without both.
REDIS_ENABLED=true
REDIS_URL=redis://default:password@host:6379

# Evolution API: base URL without a trailing slash, its API key and the instance name.
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=pizzaria

# Shared secret Evolution sends in the X-Webhook-Secret header (32+ characters):
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
